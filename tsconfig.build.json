{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Vite emits the JavaScript. tsc only emits declarations, which
    // api-extractor rolls up into dist/index.d.ts,
    // dist/react.d.ts and dist/element.d.ts.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "declarationDir": "temp/types"
  }
}
