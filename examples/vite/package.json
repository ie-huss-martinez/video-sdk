{
  "name": "@hussmartinez/video-sdk-example-vite",
  "private": true,
  "description": "Vite pages that run the built @hussmartinez/video-sdk editor with its workers inlined and self-hosted, each under its Content Security Policy, for the end-to-end tests.",
