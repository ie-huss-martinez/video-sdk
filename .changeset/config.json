{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "ie-huss-martinez/video-sdk"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "changedFilePatterns": [
    "src/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/fixtures/**",
    "!src/test/**",
    "package.json"
  ],
  "fixed": [],
  "linked": [],
  "updateInternalDependencies": "patch",
  "ignore": [],
  "privatePackages": {
    "version": false,
    "tag": false
  }
}
