    "start": "vite preview --port 4330 --strictPort"
  },
  "dependencies": {
    "@hussmartinez/ui": "catalog:",
    "@hussmartinez/video-sdk": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@hussmartinez/sdk-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
